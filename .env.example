HJC_HOST=127.0.0.1
HJC_PORT=8090
HJC_PUBLIC_BASE_URL=https://club.hijackpoker.ru
HJC_QUIZ_PUBLIC_BASE_URL=https://quiz.hijackpoker.ru
# Начальный мастер-администратор создаётся при первом запуске.
HJC_MASTER_LOGIN=master
HJC_ADMIN_PIN=change-me
HJC_ADMIN_NAME=Мастер-администратор
HJC_SECRET_KEY=replace-with-a-long-random-value
HJC_DB_PATH=data/club_tools.sqlite3
HJC_SECURE_COOKIE=true
HJC_SESSION_HOURS=12
HJC_MAX_UPLOAD_MB=15
# Часовой пояс расписания квизов.
HJC_TIMEZONE=Europe/Moscow
HJC_TELEGRAM_CLIENT_ID=
HJC_TELEGRAM_CLIENT_SECRET=
HJC_SMTP_HOST=
HJC_SMTP_PORT=587
HJC_SMTP_USERNAME=
HJC_SMTP_PASSWORD=
HJC_SMTP_FROM=
HJC_SMTP_STARTTLS=true
HJC_EMAIL_CODE_MINUTES=10
HJC_MEMBER_PORTAL_ENABLED=false
HJC_MEMBER_SESSION_DAYS=30
# Сколько минут действуют QR и 4-значный код активированной JACK CARD.
HJC_VAULT_ACTIVATION_MINUTES=10
HJC_QUIZ_DETAIL_RETENTION_DAYS=7
HJC_REWARD_RETENTION_DAYS=14
HJC_ACTION_LOG_RETENTION_DAYS=31
