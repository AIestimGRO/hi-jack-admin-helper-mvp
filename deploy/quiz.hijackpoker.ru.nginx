limit_req_zone $binary_remote_addr zone=hjc_quiz_submit:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=hjc_quiz_answer:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name quiz.hijackpoker.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name quiz.hijackpoker.ru;

    ssl_certificate /etc/letsencrypt/live/quiz.hijackpoker.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quiz.hijackpoker.ru/privkey.pem;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = / {
        proxy_pass http://127.0.0.1:8090;
    }

    location = /quiz {
        proxy_pass http://127.0.0.1:8090;
    }

    location = /quiz/telegram/start {
        limit_req zone=hjc_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /quiz/telegram/callback {
        limit_req zone=hjc_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/questions {
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/submit {
        limit_req zone=hjc_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/start {
        limit_req zone=hjc_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/identity {
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/email/request {
        limit_req zone=hjc_quiz_submit burst=3 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/email/verify {
        limit_req zone=hjc_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/answer {
        limit_req zone=hjc_quiz_answer burst=20 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/quiz/finish {
        limit_req zone=hjc_quiz_answer burst=20 nodelay;
        proxy_pass http://127.0.0.1:8090;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8090;
        expires 1h;
    }

    location / {
        return 404;
    }
}
