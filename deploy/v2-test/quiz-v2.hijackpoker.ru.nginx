limit_req_zone $binary_remote_addr zone=hjc_v2_quiz_submit:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=hjc_v2_quiz_answer:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name quiz-v2.hijackpoker.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name quiz-v2.hijackpoker.ru;

    ssl_certificate /etc/letsencrypt/live/quiz-v2.hijackpoker.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quiz-v2.hijackpoker.ru/privkey.pem;

    client_max_body_size 15m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = / { proxy_pass http://127.0.0.1:8091; }
    location = /quiz { proxy_pass http://127.0.0.1:8091; }

    location = /quiz/telegram/start {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /quiz/telegram/callback {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/questions { proxy_pass http://127.0.0.1:8091; }

    location = /api/quiz/submit {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/start {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/identity { proxy_pass http://127.0.0.1:8091; }

    location = /api/quiz/identity/confirm {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/identity/forget {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/email/request {
        limit_req zone=hjc_v2_quiz_submit burst=3 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/email/verify {
        limit_req zone=hjc_v2_quiz_submit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/answer {
        limit_req zone=hjc_v2_quiz_answer burst=20 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/finish {
        limit_req zone=hjc_v2_quiz_answer burst=20 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/final-table/status {
        proxy_pass http://127.0.0.1:8091;
    }

    location = /api/quiz/final-table/answer {
        limit_req zone=hjc_v2_quiz_answer burst=20 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location = /account {
        proxy_pass http://127.0.0.1:8091;
    }

    location ^~ /account/ {
        limit_req zone=hjc_v2_quiz_submit burst=8 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8091;
        expires 1h;
    }

    location /quiz-media/ {
        proxy_pass http://127.0.0.1:8091;
        expires 1h;
    }

    # Staging uses this host for the admin workspace as well as JACKSIDE/service
    # routes. Member/account routes are redirected to club-v2 by the app.
    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_read_timeout 60s;
    }
}
