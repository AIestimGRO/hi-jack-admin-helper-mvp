server {
    listen 80;
    listen [::]:80;
    server_name club.hijackpoker.ru quiz.hijackpoker.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 "HTTPS setup in progress\n";
        add_header Content-Type text/plain;
    }
}
